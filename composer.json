{
  "name": "osu-wams/osu_default_content",
  "description": "Drupal Module to add OSU default content",
  "minimum-stability": "stable",
  "type": "drupal-custom-module",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Alex Ruef",
      "email": "alex.ruef@oregonstate.edu"
    },
    {
      "name": "Matthew Brabham",
      "email": "matthew.brabham@oregonstate.edu"
    }
  ],
  "scripts": {
    "cs-checkstyle": "phpcs -q --report=checkstyle",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "yaml-lint": "yaml-lint *.yml"
  },
  "require-dev": {
    "drupal/coder": "^9.0",
    "squizlabs/php_codesniffer": "^4.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "j13k/yaml-lint": "^1.1.7",
    "symfony/console": "^6.4",
    "friendsoftwig/twigcs": "^6.6",
    "drupol/phpcsfixer-configs-drupal": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
